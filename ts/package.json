    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "typescript": "^5.7.2"
  },
  "bin": {
    "context-find": "./dist/cli.js",
    "cfind": "./dist/cli.js"
  }
